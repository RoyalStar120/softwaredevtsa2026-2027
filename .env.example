# SkillBridge environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (it is git-ignored) only if you need to change something.
#   cp .env.example .env
#
# NOTHING here is required. With no .env file at all, SkillBridge runs fully
# locally: SQLite database, built-in accounts, offline grounded AI coach.
#
# Every variable is read ONLY by the Node server (server/*.ts) through process.env.
# None are bundled into the browser app. Never prefix a secret with VITE_,
# because Vite would embed VITE_* variables in the public frontend bundle.
# -----------------------------------------------------------------------------

# --- AI coach (optional) ------------------------------------------------------
# Leave both keys empty to use the built-in offline coach (no account, no cost).
# If a key is set, the LLM writes the debrief narrative and answers follow-up
# questions, using only the engine's results. Any API error falls back to offline.

# Google Gemini. Free tier available. Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted as an alias if GEMINI_API_KEY is empty
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI. Paid (prepaid credits). Not needed if you use Gemini or offline.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider: gemini | openai | offline (default: Gemini if its key is set, then OpenAI, else offline)
# AI_PROVIDER=
# LLM request timeout in milliseconds (default 25000)
# AI_TIMEOUT_MS=25000

# --- Server -------------------------------------------------------------------
# HTTP port (default 3000)
# PORT=3000

# SQLite database file (default: data/skillbridge.db)
# SKILLBRIDGE_DB=data/skillbridge.db

# Set to 1 to skip creating the demo accounts and simulated class on first run
# SKIP_AUTO_SEED=0

# Set to 1 only when the site is served over HTTPS (marks the session cookie Secure)
# COOKIE_SECURE=0

# --- Developer tooling (not used by the app) ----------------------------------
# Path to Chrome/Chromium for scripts/verify.mjs screenshots (auto-detected on macOS)
# CHROME_PATH=
