# Copy to .env and fill in ONE of these to enable an LLM-powered coach.
# Without any key, SkillBridge uses its built-in grounded coach and works fully offline.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider: gemini | openai | offline
# AI_PROVIDER=

# Server port (default 3000)
# PORT=3000
